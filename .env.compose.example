# Local development only. Copy to .env.compose and change the passwords.
# URL passwords below should use URL-safe characters, or be percent-encoded
# where used in database URLs.
INCIDENT_DB_PASSWORD=123456
PAYMENT_MYSQL_PASSWORD=payment
PAYMENT_MYSQL_ROOT_PASSWORD=root-password
# Root payment_api uses these values for its application request limiter.
# They do not configure the SQLAlchemy/MySQL connection pool.
REQUEST_CONCURRENCY_LIMIT=5
REQUEST_CONCURRENCY_TIMEOUT=60
REQUEST_PROCESSING_DELAY=10
REQUEST_CONCURRENCY_WAIT_THRESHOLD=5
# Optional: without a key, chat falls back to the project's deterministic answer.
# Never put a live key in this committed template. Store real values only in the
# ignored .env.compose file or in GitHub Actions secrets.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
TAVILY_API_KEY=replace-with-your-tavily-key
