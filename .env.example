# 复制为 .env 后按需修改本地配置。.env 已被 .gitignore 排除，不要提交真实凭据。
# Copy this file to .env and fill in your own local values. Never commit real credentials.

# --- 核心基础设施 / Core infrastructure（必填） ---
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/incident
# LangGraph checkpoint 使用同步驱动；与 DATABASE_URL 指向同一个库。
GRAPH_URL=postgresql://postgres:123456@localhost:5432/incident
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP=localhost:9092
# Long Agent/RAG analysis must not trigger a consumer-group rebalance mid-task.
KAFKA_MAX_POLL_INTERVAL_MS=900000
KAFKA_SESSION_TIMEOUT_MS=30000

# --- MCP 执行层 / MCP transport ---
# Keep MCP_TRUST_ENV=false for a local endpoint so Windows/system proxy settings
# cannot intercept 127.0.0.1 traffic.
MCP_SERVER_URL=http://127.0.0.1:8931/mcp
MCP_TRUST_ENV=false
# MCP 服务自身监听地址；docker-compose 中覆盖为 0.0.0.0。
MCP_BIND_HOST=127.0.0.1

# --- 本地可观测性 / Local observability ---
MANAGED_SERVICES=payment-api,incident-api,prometheus,alertmanager
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_SERVICE_LABEL=service
# Worker 暴露 Prometheus 指标的端口。
WORKER_METRICS_PORT=9200

# --- RAG 向量库 / Local vector store ---
# 留空时默认使用仓库根目录下的 data/chroma。
# CHROMA_PATH=./data/chroma

# --- 受监控负载 payment-api / Standalone monitored workload ---
# PAYMENT_ 前缀避免该连接串覆盖 Sentinel 自己的 DATABASE_URL。
PAYMENT_DATABASE_URL=mysql+aiomysql://payment:payment@127.0.0.1:3307/payment
PAYMENT_API_URL=http://127.0.0.1:8001
# 以下变量由 payment_api 读取，字段名不带 PAYMENT_ 前缀。
ENVIRONMENT=staging
REQUEST_CONCURRENCY_LIMIT=5
REQUEST_CONCURRENCY_TIMEOUT=60
REQUEST_PROCESSING_DELAY=10
REQUEST_CONCURRENCY_WAIT_THRESHOLD=5
# 本地演示用的故障注入开关，非本地环境请保持 false。
CHAOS_ENABLED=false
CHAOS_TOKEN=replace-for-local-testing

# --- 可选外部服务 / Optional external services ---
# 未配置 DEEPSEEK_API_KEY 时前端对话回退到固定回复。
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
# 生成 RAG 向量需要 DASHSCOPE_API_KEY。
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v1
# 可选公网方案检索，结果仅作参考。
TAVILY_API_KEY=replace-with-your-tavily-key
